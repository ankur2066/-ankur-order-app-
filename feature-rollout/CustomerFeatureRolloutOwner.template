import React,{useEffect,useState} from 'react';
import {doc,onSnapshot,setDoc,serverTimestamp} from 'firebase/firestore';
import {db} from '../firebase';
import {CUSTOMER_LATER,BACKEND_REQUIRED, type RolloutConfig,type FeatureKey} from '../utils/customerFeatureRollout';

const OPTIONS:Record<string,string>={
 rates:'Rate Card / रेट कार्ड',loyalty:'Loyalty / लॉयल्टी',
 partner:'Wholesale Partner / होलसेल',subscriptions:'Regular Supply / नियमित सप्लाई',
 promotions:'Offers / ऑफर',referral:'Referral / रेफरल'
};
const VALID_UID=/^[a-zA-Z0-9_-]{12,128}$/;
export const CustomerFeatureRolloutOwner:React.FC=()=>{
 const [pilot,setPilot]=useState(false);
 const [selected,setSelected]=useState<string[]>([]);
 const [testerText,setTesterText]=useState('');
 const [suiteEnabled,setSuiteEnabled]=useState(false);
 const [serverReady,setServerReady]=useState(false);
 const [loading,setLoading]=useState(true);
 const [busy,setBusy]=useState(false);
 const [notice,setNotice]=useState('');
 useEffect(()=>{
   const stop1=onSnapshot(doc(db,'settings','customerFeatureRollout'),snapshot=>{
     const data=snapshot.data() as RolloutConfig|undefined;
     setPilot(data?.pilotEnabled===true);
     setSelected(Array.isArray(data?.enabledIds)?data.enabledIds.filter((x:unknown)=>typeof x==='string'&&CUSTOMER_LATER.includes(x as FeatureKey)) as string[]:[]);
     setTesterText(Array.isArray(data?.testerUids)?data.testerUids.filter((x:unknown)=>typeof x==='string').join('\n'):'');
     setServerReady(data?.serverReady===true);
     setLoading(false);
   },()=>{setNotice('Rollout control unavailable. Check owner permissions.');setLoading(false);});
   const stop2=onSnapshot(doc(db,'settings','featureSuite'),snap=>setSuiteEnabled(snap.data()?.enabled===true),()=>setSuiteEnabled(false));
   return ()=>{stop1();stop2();};
 },[]);
 const save=async()=>{
   if(busy)return;
   const uids=[...new Set(testerText.split(/[\s,;]+/).map(s=>s.trim()).filter(Boolean))];
   if(uids.length>20||uids.some(uid=>!VALID_UID.test(uid))){
     setNotice('20 तक वैध Firebase Customer UID डालें; फोन नंबर या ईमेल नहीं।');return;
   }
   if(pilot&&uids.length===0){setNotice('पहले 5–7 टेस्ट ग्राहकों के UID भरें।');return;}
   const backend=selected.filter(x=>BACKEND_REQUIRED.includes(x as FeatureKey));
   if(backend.length&&(!suiteEnabled||!serverReady)){
     setNotice('सर्वर वाले फीचर Live backend जाँच के बिना चालू नहीं हो सकते।');return;
   }
   setBusy(true);setNotice('');
   try{
     // This is a visibility rollout, NOT a server feature activation.
     // Firestore Rules still require the verified owner for settings writes.
     await setDoc(doc(db,'settings','customerFeatureRollout'),{
       pilotEnabled:pilot,
       testerUids:uids,
       enabledIds:selected.filter(x=>CUSTOMER_LATER.includes(x as FeatureKey)),
       updatedAt:serverTimestamp()
     },{merge:true});
     setNotice('पायलट सेटिंग सेव हुई। टेस्ट ग्राहक ऐप खोलते ही नए फीचर देखेंगे।');
   }catch{setNotice('Save failed: owner access or network check required.');}
   finally{setBusy(false);}
 };
 return <section className="rounded-2xl border border-sky-200 bg-sky-50 p-3 my-3 space-y-3" aria-label="Customer feature pilot">
   <h3 className="font-black text-base">Customer Feature Pilot · बैच 1/3</h3>
   <p className="text-xs text-slate-700">पहले 5: Ice Calculator, AI Video, FAQ, Support, Service Area। ये बिना अतिरिक्त सर्वर बदलाव के ऐप में मौजूद हैं। दूसरे फीचर केवल चुने हुए टेस्ट ग्राहकों को दिखाएँ।</p>
   <label className="flex items-center gap-2 text-sm font-semibold">
     <input type="checkbox" checked={pilot} onChange={e=>setPilot(e.target.checked)}/> 5–7 ग्राहकों के लिए आगे के फीचर खोलें
   </label>
   <label className="block text-xs font-semibold">Firebase Customer UIDs (एक प्रति लाइन, फोन/ईमेल नहीं)
     <textarea className="mt-1 block w-full rounded-lg border p-2 bg-white min-h-20" value={testerText} onChange={e=>setTesterText(e.target.value.slice(0,2700))} placeholder="Customer UID" />
   </label>
   <div className="grid grid-cols-2 gap-2">
     {CUSTOMER_LATER.map(id=><label key={id} className="rounded-lg border p-2 bg-white text-xs flex gap-2 items-start">
       <input type="checkbox" checked={selected.includes(id)}
        disabled={BACKEND_REQUIRED.includes(id)&&(!suiteEnabled||!serverReady)}
        onChange={e=>setSelected(v=>e.target.checked?[...v,id]:v.filter(x=>x!==id))}/>
       {OPTIONS[id]}
     </label>)}
   </div>
   <p className="text-xs text-slate-600">Backend readiness: {suiteEnabled&&serverReady?'verified flag active':'not confirmed'}। Backend फीचर deploy और जाँच के बिना लॉक रहेंगे। यह केवल आइकन visibility बदलता है, फाइनेंशियल या winner डेटा नहीं।</p>
   <button type="button" disabled={loading||busy} className="rounded-xl bg-sky-800 text-white font-bold p-3 disabled:opacity-50" onClick={()=>void save()}>{busy?'Saving…':'Save pilot rollout'}</button>
   {notice&&<p role="status" className="text-sm font-semibold">{notice}</p>}
 </section>;
};
