import React,{useEffect,useState} from 'react';
import {collection,doc,onSnapshot,query,where} from 'firebase/firestore';
import {getFunctions,httpsCallable} from 'firebase/functions';
import {app,db} from '../../firebase';
import type {User} from 'firebase/auth';
import {getLocalRates,subscribeToRates} from '../../data/rates';
import {downloadCommercialReceipt} from '../../utils/commercialReceipt';
import {subscribeNewOrderPush} from '../../services/orderPush';
import {parseMoney} from '../../billing/unitBilling';

const INPUT='w-full rounded-xl border b-line c-card p-3 text-sm';
const BUTTON='min-h-11 rounded-xl c-brand px-4 py-2 text-sm font-bold disabled:opacity-50';
type Field={key:string;label:string;type?:string;required?:boolean};
export function ActionForm({action,fields,defaults={},label='Submit for owner review',onDone}:{action:string;fields:Field[];defaults?:any;label?:string;onDone?:()=>void}){
 const [values,setValues]=useState<any>({...defaults}),[busy,setBusy]=useState(false),[notice,setNotice]=useState('');
 const inFlight=React.useRef(false);
 return <form className="space-y-3" onSubmit={async e=>{e.preventDefault();if(inFlight.current)return;inFlight.current=true;setBusy(true);setNotice('');try{const data={...values};for(const f of fields){if(f.type==='number')data[f.key]=Number(data[f.key]);if(f.type==='money')data[f.key]=parseMoney(String(data[f.key]));if(f.type==='datetime-local')data[f.key]=new Date(data[f.key]).getTime();}await httpsCallable(getFunctions(app,'asia-southeast1'),'ankurFeatureAction')({action,data});setNotice('Saved successfully.');onDone?.();}catch{setNotice('Could not save. Check access, values and feature setup.');}finally{inFlight.current=false;setBusy(false);}}}>
 {fields.map(f=><label key={f.key} className="block text-sm">{f.label}<input className={f.type==='checkbox'?'ml-3':INPUT} type={f.type==='money'?'number':f.type||'text'} step={f.type==='money'?'0.01':undefined} required={f.required!==false} value={f.type==='checkbox'?undefined:values[f.key]??''} checked={f.type==='checkbox'?values[f.key]===true:undefined} onChange={e=>setValues((v:any)=>({...v,[f.key]:f.type==='checkbox'?e.target.checked:e.target.value}))}/></label>)}
 <button className={BUTTON} disabled={busy}>{busy?'Saving…':label}</button>{notice&&<p role="status" className="text-sm">{notice}</p>}</form>;
}
export function useFeatureRows(path:string,user:User|null,owner:boolean,point=false){
 const [rows,setRows]=useState<any[]>([]),[ready,setReady]=useState(false),[error,setError]=useState(''),[enabled,setEnabled]=useState(false);
 useEffect(()=>onSnapshot(doc(db,'settings','featureSuite'),s=>{setEnabled(s.exists()&&s.data().enabled===true);setReady(true);},()=>{setReady(true);setEnabled(false);}),[]);
 useEffect(()=>{setRows([]);setError('');if(!enabled||(!user&&path!=='promos'))return;
 const target=point?doc(db,path,user!.uid):owner?collection(db,path):path==='promos'?query(collection(db,path),where('active','==',true)):query(collection(db,path),where('userId','==',user!.uid));
 return onSnapshot(target as any,(s:any)=>{setRows(s.docs?s.docs.map((d:any)=>({...d.data(),id:d.id})):s.exists()?[{id:s.id,...s.data()}]:[]);},()=>setError('Records are unavailable. Check feature setup and permissions.'));
 },[enabled,path,user?.uid,owner,point]);return{rows,ready,error,enabled};
}
const identity:Field[]=[{key:'customerName',label:'Customer name'},{key:'customerPhone',label:'Mobile (10 digits)',type:'tel'},{key:'address',label:'Delivery address'},{key:'quantityKg',label:'Quantity (KG)',type:'number'}];
function PartnerApplication({user,approved}:{user:User;approved:boolean}){
 const [application,setApplication]=useState<{userId:string;status:string}|null>(null);
 const [loadedUser,setLoadedUser]=useState('');
 const [error,setError]=useState('');
 useEffect(()=>{
  setLoadedUser('');setApplication(null);setError('');
  return onSnapshot(doc(db,'partnerApplications',user.uid),snapshot=>{
   setApplication(snapshot.exists()?{userId:user.uid,status:snapshot.data().status}:null);
   setLoadedUser(user.uid);
  },()=>setError('Application status could not load. Please reopen this page.'));
 },[user.uid]);
 if(approved)return <ActionForm action="bulkRequest" fields={[...identity,{key:'note',label:'Requirements'}]} defaults={{customerName:user.displayName||''}}/>;
 if(error)return <p role="alert">{error}</p>;
 if(loadedUser!==user.uid)return <p role="status">Loading application status…</p>;
 if(application?.userId===user.uid)return <p role="status">{application.status==='pending'?'Your wholesale application has been sent. Owner approval is pending.':application.status==='approved'?'Loading approved wholesale access…':'Wholesale access is currently inactive. Please contact support.'}</p>;
 return <ActionForm action="partnerApply" fields={identity} defaults={{customerName:user.displayName||''}} label="Send wholesale application" onDone={()=>setApplication({userId:user.uid,status:'pending'})}/>;
}
export function DataFeaturePanel({id,user,role}:{id:string;user:User|null;role:string|null}){
 const [pdfError,setPdfError]=useState('');
 const owner=role==='admin';const paths:Record<string,string>={loyalty:'loyaltyLedger',partner:owner?'partnerApplications':'partners',bulk:'bulkOrders',subscriptions:'subscriptions',promotions:'promos',inventory:'stock',reports:'invoices',referral:'referrals',preferences:'userPrefs',eta:'userPrefs'};
 const {rows,ready,error,enabled}=useFeatureRows(paths[id]||'userPrefs',user,owner,['loyalty','preferences','eta'].includes(id)||(id==='referral'||id==='partner')&&!owner);
 if(!user&&id!=='promotions')return <p role="status">Sign in from Profile to use your account features.</p>;
 if(!ready)return <p role="status">Loading…</p>;
 if(!enabled)return <p role="status">Feature setup is pending. Existing booking and tracking remain available.</p>;
 return <div className="space-y-5">{error&&<p role="alert">{error}</p>}{pdfError&&<p role="alert">{pdfError}</p>}
 {id==='loyalty'&&<p>Only your verified ledger is shown. No points or reward value is assumed.</p>}
 {id==='partner'&&!owner&&<><p>Bulk requests need owner-approved partner access. Prices are quoted by the owner.</p><PartnerApplication key={user!.uid} user={user!} approved={rows[0]?.status==='approved'}/></>}
 {id==='partner'&&owner&&<p>Select an application below to approve or revoke wholesale access.</p>}
 {id==='partner'&&<DataFeaturePanel id="bulk" user={user} role={role}/>}
 {id==='bulk'&&owner&&<p>Enter the agreed quote on the customer's request below.</p>}
 {id==='subscriptions'&&<><p>Regular supply needs owner approval. There is no automatic charge. Cadence: weekly or monthly.</p>{!owner&&<ActionForm action="subscriptionRequest" fields={[...identity,{key:'cadence',label:'Cadence (weekly / monthly)'}]} defaults={{customerName:user?.displayName||'',cadence:'weekly'}}/>}{owner&&<><ActionForm action="subscriptionApprove" fields={[{key:'id',label:'Subscription ID'},{key:'nextDueMs',label:'Next due date and time',type:'datetime-local'},{key:'dispatchTiming',label:'Approved dispatch slot'}]} defaults={{executionEnabled:true}} label="Approve manual execution"/><ActionForm action="runSubscription" fields={[{key:'id',label:'Due subscription ID'}]} label="Run approved due supply once"/></>}</>}
 {id==='promotions'&&owner&&<ActionForm action="promoSave" label="Save promotion configuration" defaults={{active:false}} fields={[{key:'code',label:'Code'},{key:'valuePaise',label:'Discount (₹)',type:'money'},{key:'minimumPaise',label:'Minimum order (₹)',type:'money'},{key:'usageLimit',label:'Usage limit',type:'number'},{key:'startsAtMs',label:'Starts at',type:'datetime-local'},{key:'endsAtMs',label:'Expires at',type:'datetime-local'},{key:'active',label:'Activate public code',type:'checkbox',required:false}]}/>}
 {id==='promotions'&&!owner&&rows.filter(p=>p.active&&p.startsAtMs<=Date.now()&&p.endsAtMs>=Date.now()).map(p=><PromoBooking key={p.id} promo={p} user={user}/>) }
 {id==='inventory'&&owner&&<><p>Enter actual stock only. KG balances use grams; other units use counts. Dispatch movements are irreversible here; corrections require an audited adjustment.</p><ActionForm action="stockOpening" defaults={{enabled:true}} label="Set verified opening stock" fields={[{key:'sku',label:'SKU'},{key:'unit',label:'Unit: kg / piece / box / package'},{key:'quantityUnits',label:'Opening quantity (grams or count)',type:'number'}]}/><ActionForm action="stockMapping" fields={[{key:'productId',label:'Catalog product ID (or fill legacy name)',required:false},{key:'legacyName',label:'Exact legacy product name (if no product ID)',required:false},{key:'sku',label:'Stock SKU'}]} label="Save SKU mapping"/><ActionForm action="stockAdjust" fields={[{key:'sku',label:'SKU'},{key:'requestId',label:'Unique adjustment ID'},{key:'deltaUnits',label:'Adjustment (grams/count)',type:'number'},{key:'reason',label:'Reason'}]} label="Apply audited adjustment"/><ActionForm action="stockDispatch" fields={[{key:'orderId',label:'Order ID'},{key:'sku',label:'Stock SKU'}]} label="Dispatch with stock ledger"/></>}
 {id==='referral'&&<><p>Rewards require owner review. No automatic credit is awarded.</p><ReferralLink uid={user!.uid}/><ActionForm action="referralClaim" defaults={{referrerId:localStorage.getItem('ankur.referrer')||''}} fields={[{key:'referrerId',label:'Referrer ID'}]} label="Submit first-order attribution"/></>}
 {id==='referral'&&owner&&<ActionForm action="referralReview" fields={[{key:'userId',label:'New customer user ID'},{key:'status',label:'Review: verified / rejected'}]} label="Record referral review (no credit)"/>}
 {id==='preferences'&&<><p className="text-sm">Daily Winner is optional. Change your name/city publication consent from the Daily Winner banner under AI Features, where withdrawing consent also hides any published announcement.</p><ActionForm key={rows[0]?.updatedAt?.seconds||'initial'} action="preferences" fields={[{key:'orderUpdates',label:'Order updates',type:'checkbox',required:false},{key:'promos',label:'Marketing opt-in',type:'checkbox',required:false}]} defaults={{orderUpdates:rows[0]?.orderUpdates!==false,promos:rows[0]?.promos===true}} label="Save preferences"/></>}
 {id==='reports'&&<><p>Commercial receipts are generated after delivery. No GST registration or tax is assumed. Order CSV and expense reports remain in Owner Dashboard → Insights.</p><ActionForm action="eta" fields={[{key:'orderId',label:'Order ID'},{key:'etaMs',label:'Estimated arrival date and time',type:'datetime-local'}]} label="Update delivery ETA"/></>}
 {id==='eta'&&<ActionForm action="eta" fields={[{key:'orderId',label:'Order ID'},{key:'etaMs',label:'Estimated arrival date and time',type:'datetime-local'}]} label="Update delivery ETA"/>}
 {id==='partner'&&owner&&rows.map(row=><section key={row.id} className="space-y-2 rounded-xl border b-line p-3">
 <p className="font-bold">{row.customerName||row.id}</p>
 <p className="text-sm">{row.status||'pending'}</p>
 <ActionForm key={row.status} action="partnerApprove" fields={[]} defaults={{userId:row.id,approved:row.status!=='approved'}} label={row.status==='approved'?'Revoke wholesale access':'Approve wholesale access'}/>
 </section>)}
 {rows.length===0&&!error&&<p className="text-sm t-sub">No records configured.</p>}
 <ul className="space-y-3">{(id==='partner'&&owner?[]:rows).map(row=><li key={row.id} className="border b-line rounded-xl p-3 space-y-2"><p className="font-bold">{row.code||row.sku||row.orderId||row.customerName||row.id}</p><p className="text-sm">{row.status||''}{row.availableUnits!==undefined?' · '+row.availableUnits+' '+row.unit:''}{row.approved!==undefined?' · '+(row.approved?'Approved':'Pending approval'):''}</p>{id==='bulk'&&<><p className="text-sm">{row.quantityKg} KG · {row.address}</p>{row.note&&<p className="text-sm">{row.note}</p>}{Number.isSafeInteger(row.quotedTotalPaise)&&row.quotedTotalPaise>0&&<p className="font-bold">Owner quote: ₹{(row.quotedTotalPaise/100).toFixed(2)}</p>}{owner&&<ActionForm key={String(row.quotedTotalPaise)} action="bulkQuote" fields={[{key:'totalPaise',label:'Agreed total (₹)',type:'money'}]} defaults={{id:row.id,totalPaise:row.quotedTotalPaise?row.quotedTotalPaise/100:''}} label="Save quote for this request"/>}</>}{id==='loyalty'&&<p>Verified balance: {row.points??'Policy pending'}</p>}{id==='subscriptions'&&!owner&&row.active&&<ActionForm action="subscriptionPause" defaults={{id:row.id}} fields={[]} label="Pause supply"/>}{id==='reports'&&owner&&<button className={BUTTON} onClick={()=>{void downloadCommercialReceipt(row).catch(()=>setPdfError('PDF could not be shared. Please try again.'));}}>Download PDF receipt</button>}</li>)}</ul>
 </div>;
}
function ReferralLink({uid}:{uid:string}){const[message,setMessage]=useState('');const url=new URL(location.origin+location.pathname);url.searchParams.set('ref',uid);return <><input className={INPUT} aria-label="Your referral link" readOnly value={url.toString()}/><button className={BUTTON} onClick={async()=>{try{if(navigator.share)await navigator.share({title:'Ankur Dryice',url:url.toString()});else await navigator.clipboard.writeText(url.toString());setMessage('Link shared or copied.');}catch{setMessage('Sharing cancelled or unavailable. Copy the link above.');}}}>Share referral link</button><p role="status">{message}</p></>;}

function PromoBooking({promo,user}:{promo:any;user:User|null}){
 const[rates,setRates]=useState(getLocalRates),[values,setValues]=useState<any>({customerName:user?.displayName||'',customerPhone:'',address:'',quantityKg:'10',dispatchTiming:''}),[busy,setBusy]=useState(false),[notice,setNotice]=useState(''),[result,setResult]=useState<any>(null);
 const requestId=React.useRef(crypto.randomUUID().replaceAll('-',''));const inFlight=React.useRef(false);useEffect(()=>subscribeToRates(setRates),[]);
 const base=Math.round(Number(values.quantityKg)*(rates.dryIceRate+rates.thermocolRate+(rates.transportRate||0))*100),discount=Math.min(promo.valuePaise,Math.max(0,base-1)),expectedTotalPaise=base-discount;
 return <form className="space-y-3 border rounded-xl p-3" onSubmit={async e=>{e.preventDefault();if(inFlight.current||result)return;inFlight.current=true;setBusy(true);try{const response=await httpsCallable(getFunctions(app,'asia-southeast1'),'ankurFeatureAction')({action:'promoBooking',data:{...values,quantityKg:Number(values.quantityKg),code:promo.code,requestId:requestId.current,expectedTotalPaise}});const r=response.data as any;setResult(r);try{const key='ankur_dryice_placed_orders_v1',rows=JSON.parse(localStorage.getItem(key)||'[]');localStorage.setItem(key,JSON.stringify([{...r,createdAtMs:Date.now()},...(Array.isArray(rows)?rows:[])].slice(0,20)));}catch{}void subscribeNewOrderPush(r.orderId,r.trackingPin).catch(()=>{});setNotice('Order received. Payment needs owner verification.');}catch{setNotice('Booking could not complete. Check availability, code limit and current rates. Retry keeps the same request key.');}finally{inFlight.current=false;setBusy(false);}}}>
 <h3 className="font-bold">Dry Ice booking · {promo.code}</h3><p>Base ₹{(base/100).toFixed(2)} − code discount ₹{(discount/100).toFixed(2)} = ₹{(expectedTotalPaise/100).toFixed(2)}. The server confirms the amount.</p>
 {[...identity,{key:'dispatchTiming',label:'Dispatch time requested'}].map(f=><label className="block text-sm" key={f.key}>{f.label}<input className={INPUT} required type={f.type||'text'} value={values[f.key]} onChange={e=>setValues((v:any)=>({...v,[f.key]:e.target.value}))}/></label>)}
 <button disabled={busy||!!result||base<promo.minimumPaise} className={BUTTON}>{busy?'Booking…':'Book with this code'}</button>{notice&&<p role="status">{notice}</p>}{result&&<div><p>Order {result.orderId}</p><p>Private tracking PIN: {result.trackingPin}</p><p>Total: ₹{result.totalAmount}</p><button type="button" className={BUTTON} onClick={()=>window.dispatchEvent(new CustomEvent('ankur-track-order',{detail:result}))}>Track order</button></div>}
 </form>;
}
