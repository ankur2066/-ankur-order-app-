import React,{useEffect,useRef,useState} from 'react';
import {collection,doc,limit,onSnapshot,query,where} from 'firebase/firestore';
import {getFunctions,httpsCallable} from 'firebase/functions';
import type {User} from 'firebase/auth';
import {app,db} from '../../firebase';
import {useLanguage} from '../../context/LanguageContext';

export function LoyaltyPanel({user,owner,Form}:{user:User|null;owner:boolean;Form:React.ComponentType<any>}){
 const{language}=useLanguage(),hi=language==='hi',tr=(en:string,hindi:string)=>hi?hindi:en;
 const[wallet,setWallet]=useState<any>(null),[policy,setPolicy]=useState<any>(null),[rows,setRows]=useState<any[]>([]),[error,setError]=useState(''),[notice,setNotice]=useState(''),[points,setPoints]=useState(''),[reason,setReason]=useState(''),[busy,setBusy]=useState(false);
 const request=useRef(crypto.randomUUID().replaceAll('-','')),inFlight=useRef(false);
 useEffect(()=>{setWallet(null);setRows([]);setError('');if(!user)return;const fail=()=>setError(tr('Rewards could not load. Check feature setup.','रिवार्ड लोड नहीं हुए। सुविधा का सेटअप जाँचें।'));const a=onSnapshot(doc(db,'loyaltyLedger',user.uid),s=>setWallet(s.exists()?s.data():null),fail),b=onSnapshot(doc(db,'settings','loyaltyPolicy'),s=>setPolicy(s.data()||null),fail),c=onSnapshot(owner?query(collection(db,'loyaltyRedemptions'),limit(100)):query(collection(db,'loyaltyRedemptions'),where('userId','==',user.uid),limit(50)),s=>setRows(s.docs.map(d=>({id:d.id,...d.data()}))),fail);return()=>{a();b();c();};},[user?.uid,owner,language]);
 if(!user)return <p>{tr('Sign in from Profile to view your verified rewards.','सत्यापित रिवार्ड देखने के लिए प्रोफ़ाइल से लॉगिन करें।')}</p>;
 return <section className="space-y-4">
 <p>{tr('Points are awarded once after delivery and payment verification under an owner-configured policy. No points, gifts or cash value are assumed.','मालिक की नीति के अनुसार डिलीवरी और भुगतान सत्यापन के बाद एक बार अंक मिलते हैं। कोई अंक, उपहार या नकद मूल्य अपने-आप नहीं माना जाता।')}</p>
 <p role="status">{policy?.enabled===true?tr('Reward policy is active.','रिवार्ड नीति सक्रिय है।'):tr('Reward policy is not configured or is paused.','रिवार्ड नीति सेट नहीं है या रुकी हुई है।')}</p>
 <dl className="grid grid-cols-3 gap-2"><div>{tr('Available','उपलब्ध')}<dd>{wallet?.points??tr('Not configured','सेट नहीं')}</dd></div><div>{tr('Reserved','आरक्षित')}<dd>{wallet?.reservedPoints??'—'}</dd></div><div>{tr('Redeemed','उपयोग हुए')}<dd>{wallet?.redeemedPoints??'—'}</dd></div></dl>
 {!owner&&policy?.enabled===true&&<form className="space-y-3" onSubmit={async e=>{e.preventDefault();if(inFlight.current)return;inFlight.current=true;setBusy(true);setNotice('');try{await httpsCallable(getFunctions(app,'asia-southeast1'),'ankurFeatureAction')({action:'loyaltyRedeem',data:{requestId:request.current,points:Number(points),reason}});setNotice(tr('Request reserved for owner review. No cash or order discount has been applied.','अनुरोध मालिक की समीक्षा के लिए आरक्षित है। कोई नकद या ऑर्डर छूट नहीं लगाई गई है।'));request.current=crypto.randomUUID().replaceAll('-','');setPoints('');setReason('');}catch{setNotice(tr('Could not submit. Check your verified balance and policy minimum. Retry uses the same request key.','अनुरोध नहीं भेजा जा सका। सत्यापित अंक और नीति की न्यूनतम सीमा जाँचें। दोबारा प्रयास उसी अनुरोध कुंजी से होगा।'));}finally{inFlight.current=false;setBusy(false);}}}>
 <label className="block">{tr('Points requested','चाहिए अंक')}<input className="w-full border rounded-xl p-3" type="number" step="1" min={policy.redemptionMinimumPoints} required disabled={busy} value={points} onChange={e=>setPoints(e.target.value)}/></label>
 <label className="block">{tr('Requested benefit / reason (owner confirms availability)','चाहिए लाभ / कारण (मालिक उपलब्धता बताएँगे)')}<input className="w-full border rounded-xl p-3" maxLength={300} required disabled={busy} value={reason} onChange={e=>setReason(e.target.value)}/></label><button className="c-brand p-3 rounded-xl" disabled={busy}>{tr('Request owner review','मालिक से समीक्षा माँगें')}</button></form>}
 {owner&&<><Form action="loyaltyPolicy" defaults={{enabled:false}} label={tr('Save reward policy','रिवार्ड नीति सहेजें')} fields={[{key:'enabled',label:tr('Enable after entering your real policy','अपनी वास्तविक नीति भरकर सक्रिय करें'),type:'checkbox',required:false},{key:'pointsPerDeliveredOrder',label:tr('Points per delivered and verified order','डिलीवर और सत्यापित ऑर्डर पर अंक'),type:'number',required:false},{key:'minimumOrderPaise',label:tr('Minimum qualifying order (₹)','न्यूनतम मान्य ऑर्डर (₹)'),type:'money',required:false},{key:'redemptionMinimumPoints',label:tr('Minimum points per request','अनुरोध के न्यूनतम अंक'),type:'number',required:false}]}/><Form action="loyaltyReconcile" label={tr('Check one eligible historic order','एक योग्य पुराना ऑर्डर जाँचें')} fields={[{key:'orderId',label:tr('Order ID','ऑर्डर ID')}]}/></>}
 {error&&<p role="alert">{error}</p>}{notice&&<p role="status">{notice}</p>}
 <h3 className="font-bold">{tr('Redemption requests','रिवार्ड उपयोग के अनुरोध')}</h3>{rows.length===0&&<p>{tr('No requests yet.','अभी कोई अनुरोध नहीं।')}</p>}
 {rows.map(r=><article className="border rounded-xl p-3 space-y-2" key={r.id}><p>{r.points} · {r.status==='pending_owner_review'?tr('Pending owner review','मालिक की समीक्षा बाकी'):r.status==='fulfilled'?tr('Fulfilled','लाभ दे दिया'):r.status==='rejected'?tr('Declined','मना किया'):r.status}</p><p>{r.reason}</p>{r.reviewNote&&<p>{r.reviewNote}</p>}{owner&&r.status==='pending_owner_review'&&<Form action="loyaltyReview" defaults={{id:r.id}} fields={[{key:'status',label:tr('Decision','फैसला'),options:[{value:'fulfilled',label:tr('Fulfilled','लाभ दे दिया')},{value:'rejected',label:tr('Declined','मना किया')}]},{key:'note',label:tr('Actual fulfilment or rejection note','वास्तविक लाभ देने या मना करने का नोट')}]} label={tr('Record owner decision','मालिक का फैसला दर्ज करें')}/>}</article>)}
 </section>;
}
