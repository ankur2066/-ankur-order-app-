const CalculatorPanel = () => {
  const [minutes,setMinutes]=useState(3),[machines,setMachines]=useState(1),[hours,setHours]=useState(0);const[rates,setRates]=useState(getLocalRates);React.useEffect(()=>subscribeToRates(setRates),[]);
  const result=calculateDryIce({mode:'entry',entryMinutes:minutes,entryUnits:machines,stageMinutes:0,stageUnits:0,hoursBeforeEvent:hours},rates);
  return <div className="space-y-3"><p className="text-sm t-sub">Estimate only: 3 minutes of fog per KG per machine, with transit allowance and 10% cushion. Actual performance varies.</p>{[['Fog duration (minutes)',minutes,setMinutes,120],['Machines',machines,setMachines,20],['Hours before event',hours,setHours,12]].map(([label,value,setter,max]:any)=><label key={label} className="block">{label}<input className="w-full rounded-xl border p-3" type="number" min="0" max={max} value={value} onChange={e=>setter(Math.min(max,Math.max(0,Number(e.target.value)||0)))}/></label>)}<p className="font-bold">Suggested booking: {result.bookKg} KG · Estimated ₹{result.estimatedTotal}</p><button className="c-brand rounded-xl p-3" disabled={!result.bookKg} onClick={()=>window.dispatchEvent(new CustomEvent('ankur-estimated-quantity',{detail:result.bookKg}))}>Use this quantity in booking</button><p>This action fills KG only when you press the button.</p></div>;
};

const SafePanel: React.FC<{id:FeatureId; state?:string; user:User|null;role:string|null}> = ({id,state,user,role}) => {
  if(['loyalty','partner','subscriptions','promotions','inventory','reports','referral'].includes(id))return <DataFeaturePanel id={id} user={user} role={role}/>;
  if(id==='calculator') return <CalculatorPanel/>;
  if(id==='video') return <VideoIdeaPanel/>;
  if(id==='rates') return <LiveRateCard/>;
  if(id==='support') return <div className="grid grid-cols-2 gap-3"><a className="c-brand rounded-xl p-3 text-center font-bold" href="tel:+919580882066">Call</a><a className="c-brand rounded-xl p-3 text-center font-bold" target="_blank" rel="noreferrer" href="https://wa.me/918896332066?text=Hello%20Ankur%20Dryice">WhatsApp</a></div>;
  if(id==='faq') return <div className="space-y-3 text-sm"><p><b>How should dry ice be handled?</b><br/>Use insulated gloves, keep ventilation, and never seal it in an airtight container.</p><p><b>When is delivery confirmed?</b><br/>Only after the order status and owner confirmation shown in the app.</p></div>;
  if(id==='service-area') return <ServiceAreaPanel/>;
  if(id==='catalog') return <ApplicationCatalog/>;
  return <div className="rounded-xl c-soft p-4 text-sm font-bold">{state || 'This feature uses verified account and order data.'}</div>;
};

// Pilot display gate: a missing/unavailable website manifest never unlocks unfinished tools.
function usePilotFeatureIds(){
  const [enabled,setEnabled]=useState<readonly string[]>([...PILOT_FIRST_FIVE]);
  React.useEffect(()=>{
    let active=true;
    let controller:AbortController|null=null;
    const refresh=async()=>{
      controller?.abort();
      const nextController=new AbortController();controller=nextController;
      const deadline=window.setTimeout(()=>nextController.abort(),5000);
      try{
        const next=await fetchPilotFeatures(fetch,56,nextController.signal);
        if(active&&next)setEnabled(next);
      }finally{window.clearTimeout(deadline);}
    };
    const foreground=()=>{void refresh();};
    const visible=()=>{if(document.visibilityState==='visible')void refresh();};
    void refresh();
    window.addEventListener('focus',foreground);
    document.addEventListener('visibilitychange',visible);
    const interval=window.setInterval(()=>void refresh(),5*60*1000);
    return ()=>{
      active=false;controller?.abort();window.clearInterval(interval);
      window.removeEventListener('focus',foreground);
      document.removeEventListener('visibilitychange',visible);
    };
  },[]);
  return enabled;
}

export const FeatureHub: React.FC<{currentUser:User|null; role:string|null; initial?:FeatureId|null; onClose?:()=>void;allowed?:FeatureId[]}> = ({currentUser,role,initial=null,onClose,allowed}) => {
  const {language,t}=useLanguage(); const [active,setActive]=useState<FeatureId|null>(initial);
  const pilotIds=usePilotFeatureIds();
  // Customer visibility is NOT a permission grant. Existing authenticated rules remain mandatory.
  const visible=useMemo(()=>FEATURES.filter(f=>(!f.owner||role==='admin')&&
    (!allowed||allowed.includes(f.id))&&
    (role==='admin'||f.id==='video'||pilotIds.includes(f.id))),[role,allowed,pilotIds]);
  const selected=visible.find(f=>f.id===active);
  if(selected) return <div className="c-app min-h-screen page-with-bottom-nav"><header className="c-card border-b b-line px-3 py-3 flex items-center gap-2"><button aria-label={t('back')} onClick={()=>setActive(null)} className="w-11 h-11 rounded-full flex items-center justify-center"><ArrowLeft className="w-5 h-5"/></button><h1 className="font-black">{language==='hi'?selected.hi:selected.en}</h1></header><main className="p-4 max-w-lg mx-auto"><SafePanel id={selected.id} state={selected.state} user={currentUser} role={role}/>{selected.auth&&!currentUser&&<p className="mt-3 text-sm text-amber-700">Sign in is required to use account actions.</p>}</main></div>;
  return <section className="c-card border b-line rounded-2xl p-4"><div className="flex items-center justify-between"><h2 className="text-sm font-black">{t('features')}</h2>{onClose&&<button onClick={onClose} className="text-xs t-brand">Close</button>}</div><div className="grid grid-cols-2 gap-2 mt-3">{visible.map(({id,icon:Icon,en,hi})=><button key={id} type="button" onClick={()=>setActive(id)} className="focus-ring min-h-20 c-soft rounded-xl p-3 text-left"><Icon className="w-5 h-5 t-brand"/><span className="block mt-2 text-xs font-extrabold">{language==='hi'?hi:en}</span></button>)}</div></section>;
};

export const LanguageSettings = () => { const {language,setLanguage,t}=useLanguage(); return <section className="c-card border b-line rounded-2xl p-4"><h2 className="text-sm font-black flex items-center gap-2"><Languages className="w-5 h-5 t-brand"/>{t('settings')}</h2><p className="mt-3 text-xs font-bold t-sub">{t('language')}</p><div className="grid grid-cols-2 gap-2 mt-2"><button type="button" aria-pressed={language==='en'} onClick={()=>setLanguage('en')} className={`min-h-11 rounded-xl border ${language==='en'?'b-brand c-soft':'b-line c-card'} font-bold`}>{t('english')}</button><button type="button" aria-pressed={language==='hi'} onClick={()=>setLanguage('hi')} className={`min-h-11 rounded-xl border ${language==='hi'?'b-brand c-soft':'b-line c-card'} font-bold`}>{t('hindi')}</button></div></section> };

function VideoIdeaPanel(){const[occasion,setOccasion]=useState(''),[duration,setDuration]=useState(15),[notice,setNotice]=useState('');const prompt=`Write a ${duration}-second video concept for ${occasion||'an event'} featuring Ankur Dryice. Describe scenes, captions and a call to action. Follow safe dry-ice handling. Do not claim a video has been generated.`;return <div className="space-y-3"><label className="block">Occasion<input className="w-full border rounded-xl p-3" value={occasion} onChange={e=>setOccasion(e.target.value.slice(0,200))}/></label><label className="block">Length in seconds<input className="w-full border rounded-xl p-3" type="number" min="5" max="120" value={duration} onChange={e=>setDuration(Math.min(120,Math.max(5,Number(e.target.value)||5)))}/></label><textarea readOnly aria-label="Generated prompt" className="w-full min-h-36 border rounded-xl p-3" value={prompt}/><button className="c-brand rounded-xl p-3" onClick={async()=>{try{await navigator.clipboard.writeText(prompt);setNotice('Prompt copied.');}catch{setNotice('Select and copy the prompt above.');}}}>Copy prompt</button><a className="block underline" href="https://gemini.google.com/app" target="_blank" rel="noopener noreferrer">Open Gemini</a><p role="status">{notice}</p></div>;}
function ServiceAreaPanel(){const[search,setSearch]=useState('');return <div className="space-y-3"><p>Delivery availability and timing are confirmed for each order.</p><input className="w-full border rounded-xl p-3" aria-label="Search district" placeholder="Search Uttar Pradesh district" value={search} onChange={e=>setSearch(e.target.value)}/><ul>{UP_DISTRICTS.filter(d=>d.toLowerCase().includes(search.trim().toLowerCase())).map(d=><li className="border-b py-2" key={d}>{d}</li>)}</ul></div>;}
function LiveRateCard(){const[rates,setRates]=useState(getLocalRates);React.useEffect(()=>subscribeToRates(setRates),[]);return <dl className="space-y-3"><div>Dry ice: ₹{rates.dryIceRate}/KG</div><div>Thermocol: ₹{rates.thermocolRate}/KG</div>{!!rates.transportRate&&<div>Transport: ₹{rates.transportRate}/KG under the current booking formula</div>}<p>Selected products may have their own unit and packing charges. Review the final booking bill.</p></dl>;}
function ApplicationCatalog(){const{products,loading,error}=useStorefrontProducts();const[category,setCategory]=useState('all');const[rates,setRates]=useState(getLocalRates);React.useEffect(()=>subscribeToRates(setRates),[]);return <div className="space-y-3"><label>Application / category<select className="w-full border rounded-xl p-3" value={category} onChange={e=>setCategory(e.target.value)}>{['all',...new Set(products.map(p=>p.category))].map(c=><option key={c}>{c}</option>)}</select></label>{loading&&<p>Loading…</p>}{error&&<p role="alert">{error}</p>}{products.filter(p=>p.active&&(category==='all'||p.category===category)).map(p=><article className="border rounded-xl p-3" key={p.id}><h3 className="font-bold">{p.name}</h3><p>₹{displayPricePerKg(p,rates)} / {p.unitProduct?.unit||'KG'}</p><button className="mt-2 c-brand rounded-xl p-3" onClick={()=>window.dispatchEvent(new CustomEvent('ankur-select-product',{detail:p.id}))}>Book this product</button></article>)}</div>;}
