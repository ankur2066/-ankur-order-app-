{
  "name": "ankur-dryice-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "android:sync": "npm run build && npx cap sync android",
    "android:debug": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "test:unit": "node --experimental-strip-types --test src/utils/*.test.ts",
    "test:rules": "node --test ui-fixes/customer-rules-contract.test.mjs",
    "test:rules:emulator": "firebase emulators:exec --only firestore --project demo-ankur-dryice-rules 'node --test tests/firestore.rules.test.mjs'",
    "check:theme-colors": "node scripts/check-theme-colors.mjs"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "7.0.1",
    "@capacitor-firebase/app-check": "7.5.0",
    "@capacitor-firebase/authentication": "^7.5.0",
    "@capacitor/android": "^7.4.0",
    "@capacitor/app": "7.1.2",
    "@capacitor/core": "^7.4.0",
    "@capacitor/filesystem": "7.1.9",
    "@capacitor/push-notifications": "7.0.7",
    "@capacitor/share": "7.0.4",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.1.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^11.10.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.13.0",
    "firebase-tools": "^15.35.0",
    "playwright": "^1.65.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "5.9.3"
  }
}
