import {Capacitor} from '@capacitor/core';
import {SpeechRecognition} from '@capacitor-community/speech-recognition';

export async function captureSpeech(signal:AbortSignal):Promise<string> {
  const check=()=>{if(signal.aborted)throw new Error('cancelled');};
  check();
  if(Capacitor.isNativePlatform()) {
    if(!(await SpeechRecognition.available()).available)throw new Error('unavailable');
    check();
    let permission=await SpeechRecognition.checkPermissions();
    check();
    if(permission.speechRecognition!=='granted')permission=await SpeechRecognition.requestPermissions();
    check();
    if(permission.speechRecognition!=='granted')throw new Error('permission');
    const stop=()=>{void SpeechRecognition.stop().catch(()=>{});};
    signal.addEventListener('abort',stop,{once:true});
    try {
      const result=await SpeechRecognition.start({language:'hi-IN',maxResults:1,popup:true,partialResults:false,prompt:'अपना सवाल बोलें'});
      check();
      return result.matches?.[0]?.trim().slice(0,2000)||'';
    } finally {signal.removeEventListener('abort',stop);}
  }
  const Constructor=(window as any).SpeechRecognition||(window as any).webkitSpeechRecognition;
  if(!Constructor)throw new Error('unavailable');
  return new Promise((resolve,reject)=>{
    const recognition=new Constructor();let done=false,text='';
    const finish=(error?:Error)=>{
      if(done)return;done=true;clearTimeout(deadline);signal.removeEventListener('abort',cancel);
      recognition.onresult=null;recognition.onerror=null;recognition.onend=null;
      try{recognition.abort();}catch{}
      if(error)reject(error);else resolve(text.trim().slice(0,2000));
    };
    const cancel=()=>finish(new Error('cancelled'));
    const deadline=setTimeout(()=>finish(new Error('timeout')),30000);
    recognition.lang='hi-IN';recognition.continuous=false;recognition.interimResults=false;recognition.maxAlternatives=1;
    recognition.onresult=(event:any)=>{text=Array.from(event.results as any).map((r:any)=>r[0]?.transcript||'').join(' ');finish();};
    recognition.onerror=(event:any)=>finish(new Error(['not-allowed','service-not-allowed'].includes(event.error)?'permission':'recognition'));
    recognition.onend=()=>finish();
    signal.addEventListener('abort',cancel,{once:true});
    try{check();recognition.start();}catch(error){finish(error as Error);}
  });
}
