+    // Unit products use separate collections. Legacy KG orders and prices are untouched.
+    function unitSchemaAvailable() {
+      return exists(/databases/$(database)/documents/settings/unitBilling) &&
+        get(/databases/$(database)/documents/settings/unitBilling).data.get('schemaVersion', 0) == 2;
+    }
+    function unitSalesEnabled() {
