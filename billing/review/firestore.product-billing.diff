+        b.keys().hasOnly(['unit','quantityUnits','unitPricePaise','productSubtotalPaise','packingMode','packingPricePaise','packingSubtotalPaise','deliveryFeePaise','totalPaise']) &&
+        p.active == true && p.billingVersion == 2 && p.unit in ['kg','piece','box','package'] &&
+        validPaise(p.unitPricePaise) && p.unitPricePaise > 0 && validPaise(p.packingPricePaise) && validPaise(p.deliveryFeePaise) &&
+        p.minQuantityUnits is int && p.minQuantityUnits > 0 && p.packingMode in ['none','per_unit','per_order'] &&
+        (p.packingMode != 'none' || p.packingPricePaise == 0) &&
+        b.unit == p.unit && b.quantityUnits is int && b.quantityUnits >= p.minQuantityUnits && b.quantityUnits > 0 && b.quantityUnits <= 5000 * unitScale(b.unit) &&
