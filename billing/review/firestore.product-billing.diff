+    function unitScale(unit) { return unit == 'kg' ? 1000 : 1; }
+    function validPaise(n) { return n is int && n >= 0 && n <= 9900000; }
+    function unitLinePrice(q, price, unit) {
+      return int((q * price + unitScale(unit) / 2) / unitScale(unit));
+    }
+    function validUnitProduct(d, id) {
