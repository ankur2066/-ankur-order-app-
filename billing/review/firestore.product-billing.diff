+        b.totalPaise is int && b.totalPaise > 0 && b.totalPaise <= 9900000 &&
+        b.totalPaise == b.productSubtotalPaise + b.packingSubtotalPaise + b.deliveryFeePaise;
+    }
+    function unitPrivateAfter(id) { return getAfter(/databases/$(database)/documents/product_orders/$(id)).data; }
