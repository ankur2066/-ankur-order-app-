import React,{useState} from 'react';
import {doc,setDoc,serverTimestamp} from 'firebase/firestore';
import {db} from '../firebase';
import {useUnitProducts} from '../hooks/useUnitProducts';
import {parseMoney,parseQuantity,quoteProduct,rupees,UNIT_LABELS,type UnitProduct,type BillingUnit} from '../billing/unitBilling';
import {REQUESTED_DRAFTS} from '../billing/catalogDrafts';
import {useLanguage} from '../context/LanguageContext';
const empty={id:'',name:'',hindiName:'',category:'event_effects',unit:'',price:'',packingMode:'none',packingPrice:'',delivery:'',minimum:'',active:false};
export function UnitProductManager(){
 const {language}=useLanguage();const hi=language==='hi';const ui=(en:string,hindi:string)=>hi?hindi:en;
 const unitLabel=(unit:keyof typeof UNIT_LABELS)=>hi?UNIT_LABELS[unit]:({kg:'KG',piece:'piece',box:'box',package:'package'} as const)[unit];
 const {available,enabled,products,error}=useUnitProducts(true);const [form,setForm]=useState({...empty});const [message,setMessage]=useState('');const [saving,setSaving]=useState(false);
 const field=(key:string,value:any)=>setForm(f=>({...f,[key]:value}));
 const edit=(p:UnitProduct)=>setForm({id:p.id,name:p.name,hindiName:p.hindiName,category:p.category,unit:p.unit,price:p.unitPricePaise?String(p.unitPricePaise/100):'',packingMode:p.packingMode,packingPrice:p.packingPricePaise?String(p.packingPricePaise/100):'',delivery:p.deliveryFeePaise?String(p.deliveryFeePaise/100):'',minimum:p.minQuantityUnits?String(p.minQuantityUnits/(p.unit==='kg'?1000:1)):'',active:p.active});
 const save=async(e:React.FormEvent)=>{e.preventDefault();setMessage('');if(!available){setMessage(ui('Product billing is not enabled. This is still a draft.','नई product billing अभी चालू नहीं हुई है। यह जानकारी अभी मसौदा है।'));return;}
 try{
  if(form.name.trim().length<2||form.hindiName.trim().length<2)throw Error(ui('Enter both English and Hindi product names.','प्रोडक्ट के दोनों नाम भरें।'));
  const unit=form.unit as BillingUnit;const hasUnit=Object.hasOwn(UNIT_LABELS,unit);
  const p:UnitProduct={id:form.id||'unit_'+crypto.randomUUID().replace(/-/g,''),name:form.name.trim().slice(0,100),hindiName:form.hindiName.trim().slice(0,100),category:form.category,active:form.active,billingVersion:2,unit:hasUnit?unit:'',unitPricePaise:form.price?parseMoney(form.price):0,packingMode:form.packingMode as any,packingPricePaise:form.packingMode==='none'?0:form.packingPrice?parseMoney(form.packingPrice):0,deliveryFeePaise:form.delivery?parseMoney(form.delivery):0,minQuantityUnits:hasUnit&&form.minimum?parseQuantity(form.minimum,unit):0,updatedAt:serverTimestamp()};
  if(p.active){if(!hasUnit)throw Error(ui('Select a unit first.','पहले unit चुनें।'));quoteProduct(p,p.minQuantityUnits);}
  setSaving(true);await setDoc(doc(db,'product_catalog_v2',p.id),p);setForm({...empty});setMessage(p.active?ui('Product saved.','प्रोडक्ट सहेजा गया।'):ui('Draft saved; hidden from customers.','मसौदा सहेजा गया; ग्राहकों से छिपा है।'));
 }catch(e){setMessage(e instanceof Error?e.message:ui('Could not save the product.','प्रोडक्ट सहेजा नहीं जा सका।'));}finally{setSaving(false);}};
 return <section className="c-card border b-line rounded-2xl p-4 space-y-4" aria-label={ui("Products with separate billing units","अलग unit वाले प्रोडक्ट")}>
 <h3 className="text-lg font-black t-main">{ui("Piece, Box, Package and KG products","पीस, बॉक्स, पैकेज और KG प्रोडक्ट")}</h3>
 <p className="text-sm t-sub">{ui("Each product has its own price. Packing follows the selected charge mode. Drafts are hidden from customers.","हर प्रोडक्ट की अपनी कीमत है। पैकिंग केवल चुने हुए तरीके से लगेगी। मसौदे ग्राहकों को नहीं दिखते।")}</p>
 {!available&&<p role="status" className="p-3 rounded-xl c-soft t-main">{ui("Unit billing is not available yet. You can review drafts; the live catalog will not change.","नई बिलिंग अभी उपलब्ध नहीं है। नाम और कीमत का मसौदा देख सकते हैं; लाइव कैटलॉग नहीं बदलेगा।")}</p>}
 {available&&!enabled&&<p role="status" className="p-3 rounded-xl c-soft t-main">{ui("Catalog preparation is available, but new product booking is disabled.","कैटलॉग तैयार कर सकते हैं। नए प्रोडक्ट की बुकिंग अभी बंद है।")}</p>}
 {error&&<p role="alert">{error}</p>}
 <div className="grid grid-cols-1 sm:grid-cols-2 gap-2" aria-label={ui("Requested product drafts","बताए गए प्रोडक्ट के मसौदे")}>{REQUESTED_DRAFTS.filter(d=>!products.some(p=>p.id===d.id)).map(d=><button type="button" key={d.id} className="text-left p-3 rounded-xl border b-line t-main" onClick={()=>setForm({...empty,...d})}>{hi?d.hindiName:d.name}<span className="block text-xs t-sub">{ui("Draft · set price and unit","मसौदा · कीमत और यूनिट तय करें")}</span></button>)}</div>
 <form onSubmit={save} className="space-y-3">
 <div className="grid sm:grid-cols-2 gap-3">{[['name',ui('English name','अंग्रेज़ी नाम')],['hindiName',ui('Hindi name','हिंदी नाम')]].map(([k,label])=><label key={k} className="block text-sm t-main">{label}<input required value={(form as any)[k]} onChange={e=>field(k,e.target.value)} className="block w-full rounded-xl border b-line c-soft p-3"/></label>)}</div>
 <div className="grid grid-cols-2 gap-3"><label className="text-sm t-main">Section<select value={form.category} onChange={e=>field('category',e.target.value)} className="block w-full rounded-xl border b-line c-soft p-3"><option value="pyro">{ui("Pyro","पायरो")}</option><option value="event_effects">Event Effects</option><option value="accessories">Accessories</option><option value="event_packs">Packages</option><option value="dry_ice">KG Products</option></select></label>
 <label className="text-sm t-main">Unit<select value={form.unit} onChange={e=>{field('unit',e.target.value);field('minimum','');}} className="block w-full rounded-xl border b-line c-soft p-3"><option value="">{ui("Select a unit","इकाई तय करें")}</option>{Object.keys(UNIT_LABELS).map(k=><option key={k} value={k}>{unitLabel(k as keyof typeof UNIT_LABELS)}</option>)}</select></label></div>
 <div className="grid grid-cols-2 gap-3"><label className="text-sm t-main">{ui("Price per unit","प्रति यूनिट कीमत")} ₹<input inputMode="decimal" value={form.price} onChange={e=>field('price',e.target.value)} placeholder={ui("Enter price","कीमत भरें")} className="block w-full rounded-xl border b-line c-soft p-3"/></label><label className="text-sm t-main">{ui("Minimum quantity","न्यूनतम मात्रा")}<input inputMode="decimal" value={form.minimum} onChange={e=>field('minimum',e.target.value)} placeholder={ui("Enter quantity","मात्रा भरें")} className="block w-full rounded-xl border b-line c-soft p-3"/></label></div>
 <label className="block text-sm t-main">{ui("Packing charge","पैकिंग शुल्क")}<select value={form.packingMode} onChange={e=>field('packingMode',e.target.value)} className="block w-full rounded-xl border b-line c-soft p-3"><option value="none">{ui("No packing charge","पैकिंग शुल्क नहीं")}</option><option value="per_unit">{ui("Per unit","प्रति यूनिट")}</option><option value="per_order">{ui("Once per order","पूरे ऑर्डर पर एक बार")}</option></select></label>
 {form.packingMode!=='none'&&<label className="block text-sm t-main">{ui("Packing price","पैकिंग की कीमत")} ₹<input inputMode="decimal" value={form.packingPrice} onChange={e=>field('packingPrice',e.target.value)} className="block w-full rounded-xl border b-line c-soft p-3"/></label>}
 <label className="block text-sm t-main">{ui("Delivery charge ₹ (once per order)","डिलीवरी शुल्क ₹ (पूरे ऑर्डर पर एक बार)")}<input inputMode="decimal" value={form.delivery} onChange={e=>field('delivery',e.target.value)} placeholder={ui("0 if not applicable","लागू न हो तो 0")} className="block w-full rounded-xl border b-line c-soft p-3"/></label>
 <label className="flex gap-2 text-sm t-main"><input type="checkbox" checked={form.active} onChange={e=>field('active',e.target.checked)}/>{ui("Available to customers (only with complete name, unit and price)","ग्राहकों को उपलब्ध करें (नाम, यूनिट और कीमत पूरी होने पर)")}</label>
 <div className="flex gap-2"><button disabled={!available||saving} className="rounded-xl c-brand px-5 py-3 font-bold disabled:opacity-50">{saving?ui('Saving…','सहेज रहे हैं…'):ui('Save','सहेजें')}</button><button type="button" onClick={()=>{setForm({...empty});setMessage('');}} className="rounded-xl border b-line p-3 t-main">{ui("New / clear","नया / साफ करें")}</button></div>
 </form>{message&&<p role="status" className="text-sm t-main">{message}</p>}
 <ul className="space-y-2">{products.map(p=><li key={p.id}><button type="button" onClick={()=>edit(p)} className="w-full text-left p-3 rounded-xl border b-line t-main"><strong>{hi?p.hindiName:p.name}</strong><span className="block text-xs t-sub">{p.unit&&p.unitPricePaise?rupees(p.unitPricePaise)+' / '+unitLabel(p.unit):ui('Unit/price pending','यूनिट/कीमत बाकी')} · {p.active?ui('Available','उपलब्ध'):ui('Draft','मसौदा')}</span></button></li>)}</ul>
 </section>;
}
