/** Group expense records into the owner's 15th–14th accounting months in IST. */
export interface ExpenseForCycle {
  id: string;
  amount: number;
  date: unknown;
}

function dateMs(value: unknown): number | null {
  let d: Date | null = null;
  if (value && typeof value === 'object' && 'toDate' in value && typeof value.toDate === 'function') {
    d = value.toDate();
  } else if (value && typeof value === 'object' && 'seconds' in value && typeof value.seconds === 'number') {
    d = new Date(value.seconds * 1000);
  } else if (value instanceof Date) d = value;
  else if (typeof value === 'string' || typeof value === 'number') d = new Date(value);
  return d && Number.isFinite(d.getTime()) ? d.getTime() : null;
}

/** Key identifies the starting calendar month, and is stable across locales. */
export function expenseCycleKey(value: unknown): string | null {
  const ms = dateMs(value);
  if (ms === null) return null;
  const parts = new Intl.DateTimeFormat('en-GB', {
    timeZone: 'Asia/Kolkata', year: 'numeric', month: '2-digit', day: '2-digit',
  }).formatToParts(new Date(ms));
  const part = (name: string) => Number(parts.find((p) => p.type === name)?.value);
  let year = part('year');
  let month = part('month');
  const day = part('day');
  if (day < 15) {
    month -= 1;
    if (month === 0) { year -= 1; month = 12; }
  }
  return `${year}-${String(month).padStart(2, '0')}`;
}

export function cycleLabel(key: string): string {
  if (key === 'unknown') return 'तारीख उपलब्ध नहीं';
  const [year, month] = key.split('-').map(Number);
  const start = new Date(Date.UTC(year, month - 1, 15));
  const end = new Date(Date.UTC(year, month, 14));
  const fmt = (date: Date) => date.toLocaleDateString('hi-IN', { timeZone: 'UTC', day: 'numeric', month: 'short', year: 'numeric' });
  return `${fmt(start)} – ${fmt(end)}`;
}

export function expenseDayLabel(value: unknown): string {
  const ms = dateMs(value);
  return ms === null ? 'तारीख उपलब्ध नहीं' : new Date(ms).toLocaleDateString('hi-IN', { timeZone: 'Asia/Kolkata', day: '2-digit', month: 'short', year: 'numeric' });
}

export function groupExpensesByCycle<T extends ExpenseForCycle>(expenses: T[]): Array<{ key: string; total: number; items: T[] }> {
  const groups = new Map<string, { key: string; total: number; items: T[] }>();
  for (const expense of expenses) {
    const key = expenseCycleKey(expense.date) ?? 'unknown';
    if (!groups.has(key)) groups.set(key, { key, total: 0, items: [] });
    const group = groups.get(key)!;
    const amount = Number(expense.amount);
    group.total += Number.isFinite(amount) ? amount : 0;
    group.items.push(expense);
  }
  return Array.from(groups.values()).sort((a, b) => b.key.localeCompare(a.key)).map((g) => ({ ...g, total: Math.round(g.total * 100) / 100 }));
}